# ============================================
# Beautiful-Elf 生产环境配置
# ============================================

# ---------- 应用 ----------
VITE_APP_NAME=Beautiful-Elf
VITE_APP_VERSION=0.1.0

# ---------- API 服务（生产环境） ----------
VITE_API_HOST=0.0.0.0
VITE_API_PORT=6680
VITE_API_PREFIX=/api/v1

# ---------- WebSocket（生产环境） ----------
VITE_WS_HOST=0.0.0.0
VITE_WS_PORT=6680
VITE_WS_PATH=/api/v1/ws

# ---------- 功能开关 ----------
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_SENTRY=false
