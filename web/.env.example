# ============================================
# Beautiful-Elf 本地覆盖（不会被提交，自行创建）
# 复制此文件为 .env.local 或 .env.development.local 进行覆盖
# ============================================

# ---------- 应用 ----------
# VITE_APP_NAME=Beautiful-Elf

# ---------- API 服务 ----------
# VITE_API_HOST=localhost
# VITE_API_PORT=8000
# VITE_API_PREFIX=/api/v1

# ---------- WebSocket ----------
# VITE_WS_HOST=localhost
# VITE_WS_PORT=8000
# VITE_WS_PATH=/api/v1/ws

# ---------- 功能开关 ----------
# VITE_ENABLE_MOCK=false
# VITE_ENABLE_DEVTOOLS=true
# VITE_ENABLE_SENTRY=false
