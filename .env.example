# Beautiful-Elf 环境变量配置
# 复制此文件为 .env 并填入实际值

# ═══════════════════════════════════════
# 必填项 — 未设置将导致认证失败
# ═══════════════════════════════════════

# JWT 签名密钥（用于 token 签发和验证）
# 生成命令: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# ═══════════════════════════════════════
# 数据库
# ═══════════════════════════════════════
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=beautiful_elf

# ═══════════════════════════════════════
# Redis
# ═══════════════════════════════════════
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ═══════════════════════════════════════
# Qdrant（向量数据库）
# ═══════════════════════════════════════
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ═══════════════════════════════════════
# Ollama（本地 LLM）
# ═══════════════════════════════════════
OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════
# 可选配置
# ═══════════════════════════════════════
# DEBUG=false
# JWT_EXPIRE_MINUTES=1440

# ═══════════════════════════════════════
# SearXNG（自建搜索引擎，可选）
# ═══════════════════════════════════════
# Docker 启动: docker run -d -p 8888:8080 searxng/searxng
# 填写后 web_search 工具优先使用 SearXNG，不填则降级到 DuckDuckGo
# SEARXNG_URL=http://localhost:8888
