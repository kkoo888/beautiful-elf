# ============================================
# Beautiful-Elf 后端本地覆盖（不会被提交）
# 复制此文件为 .env.local 进行覆盖
# ============================================

# ---------- FastAPI ----------
# APP_NAME=Beautiful-Elf
# DEBUG=true

# ---------- MySQL ----------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=beautiful_elf

# ---------- Redis ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- Qdrant ----------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ---------- Ollama ----------
# OLLAMA_HOST=http://localhost:11434

# ---------- LangSmith 可观测性（可选） ----------
# 启用后 LangGraph 全链路自动上报到 LangSmith 控制台
# 获取 API Key: https://smith.langchain.com/settings
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your_api_key_here
# LANGCHAIN_PROJECT=beautiful-elf
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------- CORS ----------
# CORS_ORIGINS=["http://localhost:5173","file://"]
