# ============================================
# Beautiful-Elf 后端本地覆盖（不会被提交）
# 复制此文件为 .env.local 进行覆盖
# ============================================

# ---------- FastAPI ----------
# APP_NAME=Beautiful-Elf
# DEBUG=true

# ---------- MySQL ----------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=beautiful_elf

# ---------- Redis ----------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- Qdrant ----------
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ---------- Ollama ----------
# OLLAMA_HOST=http://localhost:11434

# ---------- 可观测性（二选一，都可选） ----------
# 方案 A: LangSmith（LangChain 官方 SaaS，免费档 5000 traces/月）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_your_api_key_here
# LANGCHAIN_PROJECT=beautiful-elf

# 方案 B: LangFuse（开源自部署，完全免费，数据自主）
# LANGFUSE_PUBLIC_KEY=pk_xxx
# LANGFUSE_SECRET_KEY=sk_xxx
# LANGFUSE_HOST=https://your-langfuse-instance.com

# ---------- CORS ----------
# CORS_ORIGINS=["http://localhost:5173","file://"]

# ---------- 工作目录 ----------
# WORKSPACE_DIR=/workspace

# ---------- MCP Server ----------
# MCP_SERVER_HOST=0.0.0.0
# MCP_SERVER_PORT=8765
